# Copy this file to .env.local and fill in real values.
# Never commit .env.local (or any file with real secrets) — .gitignore already excludes .env*.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# MongoDB
# Use the connection string for your hosted MongoDB instance.
# The DB user should be scoped to readWrite on MONGODB_DB_NAME only, not an
# admin/cluster-wide user. Never hard-code this value in source code.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=hoopsync

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
#
# Sign-in methods are Google and email/password. Email/password needs no
# configuration at all - passwords are hashed with scrypt from Node's standard
# library (src/lib/password.ts) and stored on the user record - so the app has
# a working sign-in even before the Google client below is filled in.
#
# Generate AUTH_SECRET with: npx auth secret
# Google OAuth client: https://console.cloud.google.com/apis/credentials
#   Authorised JavaScript origin: http://localhost:3000
#   Authorised redirect URI:      http://localhost:3000/api/auth/callback/google
#   (add the same two on your real domain before deploying)
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Demo account created by `npm run db:seed` (development/test data only).
# Sign in with these at /sign-in to see the pre-populated training history.
# ---------------------------------------------------------------------------
SEED_DEMO_USER_EMAIL=demo.player@hoopsync.dev
SEED_DEMO_USER_PASSWORD=demo-player-1

# Comma-separated emails granted the "admin" role on sign-in. Admin gates the
# NBA roster sync route (POST /api/nba-players/sync). Without this, no account
# can ever hold the role and that route is unreachable. The CLI equivalent,
# `npm run db:sync-roster`, needs no account at all.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# OpenAI (AI Coach chat + generated feedback/summary text)
# Required for Coach to actually reply. Without it, sending a message still
# persists the player's message for real but Coach returns a clear
# "isn't configured yet" note instead of a generic failure.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Game Film analysis (BRD 7.7) reads still frames lifted from the uploaded
# clip, so it needs a vision-capable model - `gpt-4o-mini` works and is
# cheapest, `gpt-4o` reads busy court scenes more reliably.
#
# Frames are sampled in the browser (12 of them, 512px wide, sent at OpenAI's
# "low" detail tier), so one review costs roughly a cent and the server never
# decodes video. Without OPENAI_API_KEY the feature still works end to end:
# uploads succeed and the review falls back to a profile-based coaching
# profile, labelled in the UI as not having analysed the footage.
OPENAI_VISION_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# balldontlie.io (NBA player roster/bio data sync)
# Required - balldontlie's v1 API returns 401 on every endpoint without a key.
#
# TIER: the roster sync reads GET /players/active, which is an ALL-STAR tier
# endpoint ($9.99/mo, 60 req/min). The free tier (5 req/min) has only
# GET /players, which returns every player in league history with no "active"
# flag - not a current roster. A free-tier key gets a 401 here with a message
# saying exactly that.
#
# Without a key, `npm run db:sync-roster` and POST /api/nba-players/sync fail
# with a clear error; the app still runs fine on the editorial-seeded players.
# ---------------------------------------------------------------------------
BALLDONTLIE_API_BASE_URL=https://api.balldontlie.io/v1
BALLDONTLIE_API_KEY=

# ---------------------------------------------------------------------------
# Google Cloud Storage (shot/game video + profile photo upload & storage)
# GCS_SERVICE_ACCOUNT_KEY_JSON is the full service-account JSON key as a
# single-line string (not a file path) - required for serverless hosting
# where there is no reliable filesystem to mount a key file.
# ---------------------------------------------------------------------------
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_SERVICE_ACCOUNT_KEY_JSON=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Content provenance (BRD 7.14)
# ---------------------------------------------------------------------------
# Extra hosts HoopSync is allowed to load media from, comma-separated.
#
# Uploads to our own storage need nothing here. This exists so that when a
# licence is signed, the licensor's CDN can be accepted without a code change
# and redeploy. League-owned and scrape hosts are refused regardless of what
# is listed here - that denylist is not overridable by configuration, because
# BRD 7.14's "no league-owned footage before the licence" must not be one
# environment variable away from untrue.
#
# Verify with: npm run content:audit
MEDIA_ALLOWED_HOSTS=
